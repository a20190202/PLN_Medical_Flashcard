# Copia este archivo como .env y ajusta lo que necesites. Todas las variables son opcionales.

# Servidor
HOST=127.0.0.1
PORT=8000
FLASK_DEBUG=0
CORS_ORIGINS=http://localhost:3000

# LLM (Ollama). Descarga el modelo con: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=300
LLM_TEMPERATURE=0.1

# Recuperación
EMBEDDINGS_MODEL=pritamdeka/BioBERT-mnli-snli-scinli-scitail-mednli-stsb
# VECTORSTORE_DIR=app/model/data/pritamdeka_BioBERT-mnli-snli-scinli-scitail-mednli-stsb
RETRIEVAL_MODE=hybrid
# Deja vacío para desactivar el reordenamiento con cross-encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_CANDIDATES_K=20
RETRIEVAL_CONTEXT_K=3

# Puntaje mínimo (0-1) para marcar una respuesta como respaldada por los libros. 0 lo desactiva.
SUPPORT_THRESHOLD=0.6
